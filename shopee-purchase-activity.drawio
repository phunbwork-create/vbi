        <mxCell id="f10_success" value="[Thành công]" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="pool" source="dec2_pay" target="act6">
          <mxGeometry relative="1" as="geometry" />
