        <!-- Delivery Outcome Branching -->
        <mxCell id="f17_failed" value="[Giao thất bại 3 lần / Từ chối]" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="pool" source="dec3_ship" target="act12_return">
          <mxGeometry relative="1" as="geometry" />
