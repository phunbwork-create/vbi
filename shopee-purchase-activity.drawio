        <mxCell id="act6" value="6. Tạo đơn hàng &amp; Khóa số lượng tồn kho" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-shopee">
          <mxGeometry x="1110" y="30" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act7" value="7. Thông báo đơn hàng mới cho Người bán" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-shopee">
          <mxGeometry x="1310" y="30" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act12_return" value="12a. Cập nhật Hủy đơn &amp; Tạo vận đơn hoàn hàng" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-shopee">
          <mxGeometry x="1900" y="30" width="170" height="60" as="geometry" />
