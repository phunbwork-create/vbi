        <mxCell id="end_cancel" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane-shopee">
          <mxGeometry x="1290" y="175" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="act14" value="14. Hoàn tất đơn hàng &amp; Giải ngân tiền cho Người bán" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="lane-shopee">
          <mxGeometry x="2390" y="160" width="170" height="60" as="geometry" />
