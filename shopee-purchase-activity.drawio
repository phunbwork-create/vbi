        <mxCell id="f8_fail" value="[Thất bại / Hết hạn]" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="pool" source="dec2_pay" target="act_fail">
          <mxGeometry relative="1" as="geometry" />
