        <mxCell id="dec2_pay" value="Thanh toán thành công?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="lane-shopee">
          <mxGeometry x="880" y="150" width="140" height="80" as="geometry" />
