        <mxCell id="act_fail" value="Hủy đơn hàng tự động &amp; Hoàn tồn kho" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="lane-shopee">
          <mxGeometry x="1090" y="160" width="160" height="60" as="geometry" />
