        </mxCell>

        <!-- ==================== LANE 3: SELLER NODES ==================== -->
        <mxCell id="act8" value="8. Xác nhận đơn hàng &amp; Đóng gói sản phẩm" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="lane-seller">
          <mxGeometry x="1310" y="75" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act9" value="9. Bàn giao kiện hàng cho Đơn vị vận chuyển" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="lane-seller">
          <mxGeometry x="1510" y="75" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== LANE 4: COURIER NODES ==================== -->
        <mxCell id="act10" value="10. Quét mã vận đơn &amp; Vận chuyển hàng" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="lane-courier">
          <mxGeometry x="1510" y="75" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act11" value="11. Shipper tiến hành giao hàng đến Người mua" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="lane-courier">
          <mxGeometry x="1710" y="75" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dec3_ship" value="Giao hàng thành công?" style="rhombus;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="lane-courier">
          <mxGeometry x="1910" y="65" width="140" height="80" as="geometry" />
        </mxCell>

        <!-- ==================== CONTROL FLOW EDGES ==================== -->
