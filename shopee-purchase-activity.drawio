        <mxCell id="end_return" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane-shopee">
          <mxGeometry x="2100" y="45" width="30" height="30" as="geometry" />
        </mxCell>

        <!-- Lower Track (Thanh toán Online & Hoàn tất) -->
        <mxCell id="act5_online" value="5a. Xử lý thanh toán Online (ShopeePay/Thẻ/SPayLater)" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-shopee">
          <mxGeometry x="655" y="160" width="170" height="60" as="geometry" />
