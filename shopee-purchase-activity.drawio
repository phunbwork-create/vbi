<mxfile host="app.diagrams.net" modified="2026-08-02T10:58:00.000Z" agent="antigravity-ba" version="24.0.0">
  <diagram id="shopee-purchase-activity" name="Shopee Purchase Activity Diagram">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Pool + 4 Swimlanes -->
        <mxCell id="pool" value="Quy trình Mua hàng trên Sàn Thương mại Điện tử Shopee" style="swimlane;html=1;horizontal=0;childLayout=stackLayout;resizeParent=1;startSize=30;fillColor=#f5f5f5;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="2720" height="920" as="geometry" />
        </mxCell>
        <mxCell id="lane-customer" value="Người mua hàng (Customer)" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="0" width="2690" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lane-shopee" value="Hệ thống Shopee (System &amp; Payment)" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="220" width="2690" height="280" as="geometry" />
        </mxCell>
        <mxCell id="lane-seller" value="Người bán (Shopee Seller / Shop)" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="500" width="2690" height="210" as="geometry" />
        </mxCell>
        <mxCell id="lane-courier" value="Đơn vị vận chuyển (Courier / NVC)" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="pool">
          <mxGeometry x="30" y="710" width="2690" height="210" as="geometry" />
        </mxCell>

        <!-- ==================== LANE 1: CUSTOMER NODES ==================== -->
        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="lane-customer">
          <mxGeometry x="30" y="95" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="act1" value="1. Tìm kiếm, chọn sản phẩm &amp; Thêm vào Giỏ hàng" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=0;" vertex="1" parent="lane-customer">
          <mxGeometry x="90" y="80" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act2" value="2. Chọn Voucher, Địa chỉ &amp; Phương thức thanh toán" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lane-customer">
          <mxGeometry x="280" y="80" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act3" value="3. Bấm 'Đặt hàng'" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-customer">
          <mxGeometry x="480" y="80" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act12_success" value="12b. Nhận hàng &amp; Bấm 'Đã nhận được hàng'" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="lane-customer">
          <mxGeometry x="2180" y="80" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="act13" value="13. Đánh giá sản phẩm (Tùy chọn)" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="lane-customer">
          <mxGeometry x="2400" y="80" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- ==================== LANE 2: SHOPEE SYSTEM NODES ==================== -->
        <!-- Upper Track (Luồng chính & COD) -->
        <mxCell id="act4" value="4. Kiểm tra tồn kho &amp; Tính toán giá tiền / Voucher" style="rounded=1;html=1;arcSize=30;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="lane-shopee">
